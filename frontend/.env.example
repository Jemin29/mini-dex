# Mini-DEX Frontend Environment Variables
# Copy this file to .env.local and fill in your values.

# -------------------------
# Required: Contract Addresses
# -------------------------
# Set these to your deployed contract addresses after running `npx hardhat run scripts/deploy.ts`
NEXT_PUBLIC_ROUTER_ADDRESS=0x0000000000000000000000000000000000000001
NEXT_PUBLIC_POOL_ADDRESS=0x0000000000000000000000000000000000000002

# -------------------------
# Required: Authentication
# -------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
# Set to your deployment URL in production (e.g., https://mini-dex.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# -------------------------
# Required: WalletConnect
# -------------------------
# Get a project ID from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=demo

# -------------------------
# Optional: RPC URLs
# -------------------------
# Custom RPC URL for Sepolia (defaults to public RPC if not set)
NEXT_PUBLIC_RPC_URL=
# Comma-separated list of fallback RPC URLs
NEXT_PUBLIC_RPC_URLS=

# -------------------------
# Optional: Backend API
# -------------------------
# URL to the Express backend (if deployed separately)
NEXT_PUBLIC_BACKEND_URL=

# -------------------------
# Optional: Google OAuth
# -------------------------
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# -------------------------
# Optional: Email Authentication
# -------------------------
# Requires a database adapter to be configured in auth.ts
# AUTH_EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# AUTH_EMAIL_FROM=noreply@example.com
